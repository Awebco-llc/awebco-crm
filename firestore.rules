rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get the user's role from their profile document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper function to check if the user has a valid team member role
    function hasValidRole() {
      return getUserRole() in ['master_admin', 'admin', 'staff', 'freelancer'];
    }

    // Allow public ticket creation (for gravity forms webhook routing)
    match /tickets/{ticketId} {
      allow create: if true;
    }

    // Secure access: Only authenticated team members with a valid role can read/write.
    match /{collection}/{document=**} {
      allow read, write: if collection != '_mcp' && collection != 'users'
        && isAuthenticated() && hasValidRole();
    }

    // _mcp contains server-managed key hashes, activation, budgets and audit events.
    // No browser client, including the master admin, may access this collection.
    match /_mcp/{document=**} {
      allow read, write: if false;
    }
    
    // Exception: Users need to be able to read their own profile to get their role
    match /users/{userId} {
      function isMasterAdmin() {
        return isAuthenticated() && getUserRole() == 'master_admin';
      }
      function isValidUser() {
        return request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.role in ['master_admin', 'admin', 'staff', 'freelancer'];
      }
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasValidRole());
      allow create: if isValidUser() && (
        isMasterAdmin() || (isAuthenticated() && getUserRole() == 'admin'
          && request.resource.data.role != 'master_admin')
      );
      allow update: if isValidUser()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authUid', 'uid'])
        && (
          isMasterAdmin()
          || (isAuthenticated() && getUserRole() == 'admin'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions', 'updatedAt'])
            && resource.data.role != 'master_admin')
          || (isAuthenticated() && request.auth.uid == userId && hasValidRole()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'initials', 'color', 'photoUrl', 'emailNotificationsEnabled', 'password', 'updatedAt'
            ]))
        );
      allow delete: if isMasterAdmin() || (isAuthenticated() && getUserRole() == 'admin'
        && resource.data.role != 'master_admin');
    }
  }
}
